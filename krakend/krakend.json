{
  "version": 3,
  "name": "SmartLogix API Gateway",
  "port": 8080,
  "timeout": "10s",
  "cache_ttl": "0s",
  "output_encoding": "no-op",
  "host": ["http://bff:8081"],

  "extra_config": {
    "security/cors": {
      "allow_origins": [
        "*"
      ],
      "allow_methods": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
      "allow_headers": ["Origin", "Authorization", "Content-Type", "Accept"],
      "expose_headers": ["Content-Length"],
      "max_age": "12h",
      "allow_credentials": true
    },
    "telemetry/logging": {
      "level": "DEBUG",
      "prefix": "[KRAKEND]",
      "syslog": false,
      "stdout": true
    }
  },

  "telemetry/logging": {
    "level": "DEBUG",
    "prefix": "[KRAKEND]",
    "syslog": false,
    "stdout": true
  },

